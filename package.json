{
  "name": "municipal-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Municipal data platform POC: map the organization, learn the ontology, discover workflows, propose automations.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/server.ts",
    "dev": "node --env-file-if-exists=.env.local --watch src/server.ts",
    "theme:build": "node scripts/build-aka-theme.mjs",
    "demo": "node src/demo.ts",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  }
}
